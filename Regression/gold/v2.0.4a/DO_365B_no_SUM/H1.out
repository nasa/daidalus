above_relative_hs = 0.0 [knot]
below_relative_vs = 0.0 [fpm]
above_relative_vs = 0.0 [fpm]
below_relative_alt = 0.0 [ft]
above_relative_alt = 0.0 [ft]
# Kinematic Parameters
step_hdir = 1.0 [deg]
step_hs = 5.0 [knot]
step_vs = 100.0 [fpm]
step_alt = 100.0 [ft]
horizontal_accel = 2.0 [m/s^2]
vertical_accel = 0.25 [G]
