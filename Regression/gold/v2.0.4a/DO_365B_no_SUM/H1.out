# Bands Parameters
lookahead_time = 180.0 [s]
# Traffic aircraft farther than this distance to the ownship are ignored. Zero means no filter
distance_filter = 0.0 [nmi]
# Traffic aircraft above/below this altitude to the ownship are ignored. Zero means no filter
altitude_filter = 0.0 [ft]
left_hdir = 180.0 [deg]
right_hdir = 180.0 [deg]
min_hs = 10.0 [knot]
max_hs = 700.0 [knot]
min_vs = -6000.0 [fpm]
max_vs = 6000.0 [fpm]
min_alt = 100.0 [ft]
max_alt = 50000.0 [ft]
# Relative Bands Parameters
